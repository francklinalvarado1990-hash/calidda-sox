# ---------- Etapa de construccion ----------
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @calidda-sox/api --include-workspace-root

COPY apps/api ./apps/api
RUN npx prisma generate --schema apps/api/prisma/schema.prisma \
 && npm run build --workspace @calidda-sox/api

# ---------- Imagen de ejecucion ----------
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production TZ=America/Lima

RUN apk add --no-cache tzdata tini \
 && addgroup -S sox && adduser -S sox -G sox

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/api/prisma ./prisma
COPY --from=build /app/apps/api/package.json ./package.json

RUN mkdir -p /app/storage && chown -R sox:sox /app
USER sox

EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:3001/api/salud').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/sbin/tini", "--"]
# Aplica las migraciones pendientes antes de levantar el servicio.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/server.js"]
