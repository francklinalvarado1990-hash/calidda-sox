# ============================================================================
# Repositorio de Controles SOX - Calidda / Calidda Energia
# Copie este archivo a .env y complete los valores. NUNCA versione el .env real.
# ============================================================================

NODE_ENV=development
TZ=America/Lima

# --- Base de datos ---------------------------------------------------------
DATABASE_URL=postgresql://sox:sox@localhost:5432/calidda_sox?schema=public

# --- API -------------------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173

# --- Seguridad -------------------------------------------------------------
# Genere con: openssl rand -base64 48
JWT_SECRET=cambieme-por-un-secreto-de-al-menos-32-caracteres-aleatorios
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7
# Bloqueo de cuenta tras N intentos fallidos
MAX_INTENTOS_LOGIN=5
BLOQUEO_MINUTOS=15
# Exigir MFA (TOTP) a estos roles, separados por coma. Vacio = ninguno.
MFA_ROLES_OBLIGATORIO=ADMIN,SOX_MANAGER

# --- Almacenamiento de evidencias -----------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_MB=25
RETENCION_ANIOS=7
# Solo si STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=calidda-sox-evidencias
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Correo ----------------------------------------------------------------
# smtp | console  (console imprime el correo en el log, util en desarrollo)
MAIL_DRIVER=console
MAIL_FROM="Controles SOX Calidda <sox-no-reply@calidda.com.pe>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Copia oculta de los resumenes de cierre (PMO SOX / auditoria interna)
MAIL_BCC_GOBIERNO=

# --- Ciclo mensual ---------------------------------------------------------
# Dia del mes en que se abre automaticamente el periodo siguiente
DIA_APERTURA_PERIODO=1
# Dias habiles despues del fin de mes como fecha limite de cierre del periodo
DIAS_HABILES_CIERRE_PERIODO=10
# Dias de anticipacion para recordatorios de vencimiento
RECORDATORIO_DIAS_PREVIOS=7,3,1
# Cada cuantos dias se reitera el aviso de un control ya vencido
RECORDATORIO_VENCIDO_CADA_DIAS=2
# Habilita los jobs programados (apagar en instancias replica)
JOBS_HABILITADOS=true

# --- SSO (opcional, para una segunda etapa) --------------------------------
SSO_HABILITADO=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
